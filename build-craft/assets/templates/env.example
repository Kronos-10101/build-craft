# Copy to repo root as .env.example — the canonical env-var contract.
# Every required variable is listed here with a placeholder value.
# Never commit a real .env file.

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/mydb

# App
APP_ENV=development          # development | staging | production
APP_SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
LOG_LEVEL=info               # debug | info | warning | error

# Third-party APIs
# STRIPE_SECRET_KEY=sk_test_...
# SENTRY_DSN=
